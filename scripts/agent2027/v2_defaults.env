# Full-v2 flag values (01 §7 R3/R4). DRAFT until G1 (Fri 16 Oct): the values marked
# PIN@G1 are the proposed ones and are replaced by the G1 decisions before the
# agent2027-v2.0 freeze.
#
# Format: KEY=VALUE, one per line, no quotes, no spaces around '=', no inline comments.
# ro27_clients_manifest.sh reads this file (from inside the image, so the defaults are
# the ones the image was built with), applies the row's env_overrides on top, then the
# per-row keys (dataset, seeds, models, ports, W&B project) and the run-identity keys,
# and hands the merged list to `docker run --env-file`. Per-row keys are therefore NOT
# set here: ROGUE_ONE_FOLD_SEED, ROGUE_ONE_LLM_SEED, ROGUE_ONE_DATASETS, LLM_MODEL,
# LLM_PORT, LLM_API_KEY, ROGUE_ONE_<ROLE>_MODEL/_PORT, WANDB_PROJECT_NAME, WANDB_API_KEY,
# ROGUE_ONE_TASK_REGISTRY.

# --- R3: existing flags -------------------------------------------------------------
ROGUE_ONE_NUM_ITERATIONS=10
ROGUE_ONE_K_FOLDS=5
ROGUE_ONE_SELECTION_SIGNAL=inner_cv
ROGUE_ONE_ENABLE_ROLLBACK=False
# True on SYN-P classification rows via env_overrides if D4; else False.
ROGUE_ONE_STRATIFIED_FOLDS=False
ROGUE_ONE_DO_BALANCING=True
ROGUE_ONE_FOLD_RETRY_LIMIT=1
ROGUE_ONE_DO_LOGGING=True
ROGUE_ONE_START_VLLM=False
ROGUE_ONE_DISABLE_WANDB=0
ROGUE_ONE_VERBOSE_AGENT_ERRORS=0
CONSOLE_DISABLE=False
LLM_TEMPERATURE=0.7
SCIENTIST_AGENT_TEMPERATURE=0.7
EXTRACTOR_AGENT_TEMPERATURE=0.7
TESTER_AGENT_TEMPERATURE=0.7
MEDICAL_KNOWLEDGE_AGENT_TEMPERATURE=0.7
EXTRACTOR_AGENT_MAX_TOKENS=32768
TESTER_AGENT_MAX_TOKENS=8192
# PIN@G1 (proposed 16384)
SCIENTIST_AGENT_MAX_TOKENS=16384
EXTRACTOR_AGENT_MAX_ITERATIONS=100
TESTER_AGENT_MAX_ITERATIONS=100
SCIENTIST_AGENT_MAX_ITERATIONS=200
WANDB_ENTITY=PlanBench

# --- R4: new flags --------------------------------------------------------------------
ROGUE_ONE_TOOL_ERROR_FEEDBACK=message
# PIN@G1: R frozen by A02 (code default 10)
ROGUE_ONE_EXTRACTOR_ROUNDS=10
# PIN@G1 (proposed 8000)
ROGUE_ONE_TOOL_OUTPUT_MAX_CHARS=8000
ROGUE_ONE_REASONING_EFFORT_PASSTHROUGH=0
ROGUE_ONE_LLM_TRACE=1
ROGUE_ONE_PROMPT_DUMP=1
# PIN@G1: M1 decision by A03 (pre-freeze arms set it explicitly)
ROGUE_ONE_FEATURE_POOL_MODE=augment
ROGUE_ONE_REPLAY_VALIDITY_CHECK=1
ROGUE_ONE_SEARCH_CACHE=off
ROGUE_ONE_SEARCH_CACHE_PATH=/workspace/cache/serper_cache.sqlite
ROGUE_ONE_WEBSEARCH_ROUTING=caller
# Web-search provider (HQ #266, Henrik 2026-10-13): self-hosted SearXNG on CAIR, container
# ro27-searxng, image searxng:ro27-2026.10.11, settings ~/ro27_searxng/settings.yml.
ROGUE_ONE_WEB_SEARCH_PROVIDER=searxng
ROGUE_ONE_SEARXNG_URL=http://127.0.0.1:8888
ROGUE_ONE_KNOWLEDGE_BACKEND=web
ROGUE_ONE_TOPOLOGY=three_agent
ROGUE_ONE_PLANNER_MODE=llm
ROGUE_ONE_MEMORY_MODE=full
ROGUE_ONE_ASSESSMENT_MODE=llm
ROGUE_ONE_PRUNING_MODE=llm
ROGUE_ONE_PRUNING_SHADOW=0
ROGUE_ONE_RESTART_MODE=off
ROGUE_ONE_FEEDBACK_LEVEL=full
# PIN@G1: on if E13 lands, else off (frozen)
ROGUE_ONE_SANDBOX=on
ROGUE_ONE_FALLBACKS=on
# E14 / D2 (HQ #245, Henrik 2026-10-09): the Scientist sees the L1 inner-CV scalar on a
# split crossed with the selection split (rogueone/utils/scientist_signal.py); code default train_fit.
ROGUE_ONE_SCIENTIST_SIGNAL=inner_cv_l1
