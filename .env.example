# RougeOne environment configuration template.
# Copy to .env and replace placeholder values.

# ========================
# Required runtime settings
# ========================

# REQUIRED: Main LLM model id (OpenAI-compatible serving endpoint)
LLM_MODEL="openai/gpt-oss-20b"
# OPTIONAL (default: 0.7): Sampling temperature for model calls
LLM_TEMPERATURE=0.7
# OPTIONAL (default: 3): Max retry attempts for LLM API calls
LLM_MAX_RETRIES=3
# REQUIRED: Port for local LLM server
LLM_PORT=8010
# REQUIRED: API key for local LLM server
LLM_API_KEY="change-me"
# OPTIONAL: GPU allocation for LLM server process
LLM_GPUS="0"

# REQUIRED: Embedding model id
EMBEDD_MODEL="Qwen/Qwen3-Embedding-4B"
# OPTIONAL (default: 1): Embedding request chunk size
EMBEDD_CHUNK_SIZE=1
# REQUIRED: Port for local embedding server
EMBEDD_PORT=8011
# REQUIRED: API key for local embedding server
EMBEDD_API_KEY="change-me"
# OPTIONAL: GPU allocation for embedding server process
EMBEDD_GPUS="1"

# ========================
# Optional infrastructure
# ========================

# OPTIONAL: Vector DB default path for utility scripts
VECTOR_DB_PATH="./vector_db"
# OPTIONAL: Vector DB default collection
VECTOR_DB_COLLECTION="rougeone_literature"

# OPTIONAL (default: 3): Number of RogueOne iterations
ROGUE_ONE_NUM_ITERATIONS=3
# OPTIONAL (default: 0.8): Training split ratio
ROGUE_ONE_TRAIN_SIZE=0.8
# OPTIONAL (default: True): Enable W&B logging
ROGUE_ONE_DO_LOGGING="True"
# OPTIONAL (default: 5): CV fold count
ROGUE_ONE_K_FOLDS=5
# OPTIONAL (default: 42): Deterministic seed for fold generation
ROGUE_ONE_FOLD_SEED=42
# OPTIONAL (default: 1): Retry attempts per failed fold trial
ROGUE_ONE_FOLD_RETRY_LIMIT=1
# OPTIONAL (default: True): Enable balancing behavior
ROGUE_ONE_DO_BALANCING="True"

# OPTIONAL (default: False): Disable rich console output
CONSOLE_DISABLE=False

# OPTIONAL: Weights & Biases project metadata
WANDB_PROJECT_NAME="rogueone_project"
WANDB_ENTITY=""
WANDB_API_KEY=""

# OPTIONAL: API key used by web-search utility
SERPER_API_KEY=""

# ========================
# Agent settings
# ========================

# OPTIONAL (default: 0.7): Extractor agent temperature
EXTRACTOR_AGENT_TEMPERATURE=0.7
# OPTIONAL (default: medium): Extractor reasoning effort
EXTRACTOR_AGENT_REASONING_EFFORT="medium"
# OPTIONAL (default: 100): Extractor max iterations
EXTRACTOR_AGENT_MAX_ITERATIONS=100

# OPTIONAL (default: 0.7): Medical knowledge agent temperature
MEDICAL_KNOWLEDGE_AGENT_TEMPERATURE=0.7
# OPTIONAL (default: medium): Medical knowledge reasoning effort
MEDICAL_KNOWLEDGE_AGENT_REASONING_EFFORT="medium"
# OPTIONAL (default: 100): Medical knowledge max iterations
MEDICAL_KNOWLEDGE_AGENT_MAX_ITERATIONS=100

# OPTIONAL (default: 0.7): Tester agent temperature
TESTER_AGENT_TEMPERATURE=0.7
# OPTIONAL (default: medium): Tester reasoning effort
TESTER_AGENT_REASONING_EFFORT="medium"
# OPTIONAL (default: 100): Tester max iterations
TESTER_AGENT_MAX_ITERATIONS=100

# OPTIONAL (default: 0.7): Orchestrator (Scientist) temperature
ORCHESTRATOR_AGENT_TEMPERATURE=0.7
# OPTIONAL (default: medium): Orchestrator reasoning effort
ORCHESTRATOR_AGENT_REASONING_EFFORT="medium"
# OPTIONAL (default: 100): Orchestrator max iterations
ORCHESTRATOR_AGENT_MAX_ITERATIONS=100

# ========================
# Backward-compatible aliases (legacy)
# These are optional and can be removed once migrated.
# ========================

EXTRACTION_AGENT_TEMPERATURE=0.7
EXTRACTION_AGENT_REASONING_EFFORT="medium"
EXTRACTION_AGENT_MAX_ITERATIONS=100
TEST_AGENT_TEMPERATURE=0.7
TEST_AGENT_REASONING_EFFORT="medium"
TEST_AGENT_MAX_ITERATIONS=100
