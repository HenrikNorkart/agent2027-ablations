# Classical (non-LLM) feature-engineering baselines for T0.4: OpenFE and AutoFeat,
# scored under Rogue One's own folds and XGBoost evaluator.
#
# CPU-only by design -- neither baseline uses a GPU, so these runs must never occupy
# one on a shared box.
#
# Rebuilt 2026-08-14. An earlier `classicfe:2` image existed in July but was pruned
# from the CAIR daemon, and its Dockerfile was never kept, which is why this file now
# lives in the repo instead of only on the server.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pinned so a re-run of the T0.4 table is reproducible. numpy is held below 2.0
# because autofeat's sympy-based feature construction still assumes the 1.x ABI.
# matplotlib is required even though nothing here plots: OpenFE imports it at module
# load, so without it every OpenFE cell dies instantly with ModuleNotFoundError.
RUN pip install --no-cache-dir \
        "numpy==1.26.4" \
        "pandas==2.2.3" \
        "scikit-learn==1.5.2" \
        "xgboost==2.1.3" \
        "pyarrow==17.0.0" \
        "scipy==1.13.1" \
        "sympy==1.13.3" \
        "matplotlib==3.9.2" \
        "openfe==0.0.12" \
        "autofeat==2.1.3"

WORKDIR /work
CMD ["python", "-c", "import openfe, autofeat, xgboost; print('classicfe ok')"]
